{
    "name": "youvision/think-theme",
    "description": "ThinkPHP 8 设备主题切换：基于 Mobile-Detect 自动识别 computer、phone、tablet、wechat 等设备类型并定位到不同的模板目录。",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "theme",
        "device",
        "mobile-detect",
        "template"
    ],
    "authors": [
        {
            "name": "youvision"
        }
    ],
    "require": {
        "php": ">=8.1",
        "mobiledetect/mobiledetectlib": "^3.74 || ^4.0",
        "topthink/framework": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "topthink/think-view": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkTheme\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkTheme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkTheme\\Service"
            ],
            "config": {
                "theme": "config/theme.php"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "topthink/think-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
